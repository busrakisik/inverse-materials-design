  "title": "MaterialValidationFeedback",
  "type": "object",
  "required": ["iteration", "structure_id", "is_valid", "formula", "errors", "summary"],
  "properties": {
    "iteration": { "type": "integer" },
    "structure_id": { "type": "string" },
    "formula": { "type": "string" },
